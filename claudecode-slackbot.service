[Unit]
Description=Claude Code Slackbot
After=network.target

[Service]
Type=simple
User=claude
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/path/to/claudecode-slackbot
EnvironmentFile=/path/to/claudecode-slackbot/.env
ExecStart=/usr/bin/uv run app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
